# WilderedOS Test Edition Package List
# Standard packages + Wine for Windows application support

# === STANDARD PACKAGES (inherited) ===
# See standard.list for all standard packages

# === WINE ===
wine
wine64
wine32

# Wine dependencies (32-bit support)
libc6:i386
libncurses5:i386
libstdc++6:i386
lib32z1
lib32ncurses6

# === WINE TOOLS ===
winetricks
winbind
cabextract

# === WINE COMPONENTS ===
wine-mono
wine-gecko

# === WINDOWS FONTS ===
ttf-mscorefonts-installer
fonts-wine

# === WINDOWS APP SUPPORT ===
# Additional libraries for Windows app compatibility
libgl1-mesa-dri:i386
libgl1:i386
libglu1-mesa:i386
libosmesa6:i386
libdrm2:i386
libgbm1:i386

# === AUDIO SUPPORT FOR WINE ===
libasound2:i386
libasound2-plugins:i386
libpulse0:i386

# === VIDEO CODECS FOR WINE ===
libgstreamer1.0-0:i386
libgstreamer-plugins-base1.0-0:i386

# === VULKAN SUPPORT (for gaming) ===
mesa-vulkan-drivers
mesa-vulkan-drivers:i386
vulkan-tools

# === ADDITIONAL WINDOWS COMPATIBILITY ===
libvulkan1
libvulkan1:i386

# === WINDOWS INSTALLERS ===
msitools
gcab

# === WINDOWS REGISTRY TOOLS ===
regedit

# === MONO FOR .NET APPS ===
mono-complete

# === WINDOWS TERMINAL EMULATOR ===
# For running Windows console apps
wineconsole
